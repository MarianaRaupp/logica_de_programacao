programa {
  funcao inicio() {
    real mes 
    escreva("\n digite o numero do mes: ")
    leia(mes) 
    se (mes == 1){ 
    escreva("seu mês é janeiro: " ,mes)}
    
    senao se(mes == 2){ 
    escreva("seu mês é fevereiro: " ,mes)}
    
    senao se (mes == 3){ 
    escreva("seu mês é março: " ,mes)}
    
    senao se(mes == 4){ 
    escreva("seu mês é abril: " ,mes)}
    
     senao se (mes == 5){ 
    escreva("seu mês é maio: " ,mes)}
    
    senao se(mes == 6){ 
    escreva("seu mês é junho: " ,mes)}
    
     senao se (mes == 7){ 
    escreva("seu mês é julho: " ,mes)}
   
    senao se(mes == 8){ 
    escreva("seu mês é agosto: " ,mes)}
  
     senao se (mes == 9){ 
    escreva("seu mês é setembro: " ,mes)}
    
    senao se(mes == 10){ 
    escreva("seu mês é outubro: " ,mes)}
   
     senao se (mes == 11){ 
    escreva("seu mês é novembro: " ,mes)}
   
    senao se(mes == 12){ 
    escreva("seu mês é dezembro: " ,mes)}

    senao
    escreva("numero inválido")



  }
}
