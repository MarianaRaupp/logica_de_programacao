programa {
  funcao inicio() {
    real positivo, negativo, zero, numero
     escreva("Escreva um numero: ")
     leia(numero)

     se (numero > 0)
     escreva("\n este numero é positivo")
    
    senao se (numero < 0)
    escreva("\n este numero é negativo")

    senao se (numero == 0)
    escreva("\n este numero é zero")

    
  }
}
