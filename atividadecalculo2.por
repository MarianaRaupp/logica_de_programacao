programa {
  funcao inicio() { 
    real x, m, a, h, v 
    escreva("\n qual é o vaor de m: ")
    leia(m)
    escreva("\n qual é o valor de a: ")
    leia(a)
    escreva("\n qual é o valor de h: ")
    leia(h)
    escreva("\n qual é o valor de v: ")
    leia(v)

    x = m*(a*h)+(v*v/2)
    escreva("\n O valor é: " ,x)    
  }
}
